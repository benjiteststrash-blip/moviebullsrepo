{
  "name": "moviebulls",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:player": "node --test player/filter.test.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:player": "wrangler deploy --config player/wrangler.jsonc --profile moviebulls",
    "deploy": "npm run build:cloudflare && wrangler deploy --profile moviebulls",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && wrangler types --config player/wrangler.jsonc --env-interface PlayerEnv player/worker-configuration.d.ts",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "predev": "npm run prepare:offline",
    "prebuild": "npm run prepare:offline",
    "prebuild:cloudflare": "npm run prepare:offline",
    "test:offline": "node --test tests/offline.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "hls.js": "1.7.4",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
